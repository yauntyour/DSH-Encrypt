{
  "name": "dsh-encrypt",
  "version": "0.2.1",
  "description": "WebUI-managed encrypted credentials for DeepSeek Harness: one file, plaintext until a password is set, then AES-256-GCM ciphertext under an Argon2id-derived key with SHA3-256 fingerprints; per-request decryption, unlock lockout, leak-guard output redaction, and shipped-code integrity self-checks.",
  "keywords": [
    "aes-256-gcm",
    "argon2id",
    "credentials",
    "deepseek",
    "dsh",
    "encryption",
    "leak-guard",
    "password",
    "prompt-injection",
    "sha3-256"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./vault": {
      "types": "./lib/vault.d.ts",
      "import": "./lib/vault.js"
    },
    "./web": {
      "types": "./lib/web.d.ts",
      "import": "./lib/web.js"
    },
    "./client": {
      "types": "./lib/client.d.ts",
      "import": "./lib/client.js",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && tsdown -c tsdown.client.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm knip",
    "dev": "tsdown --watch",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "pnpm build",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.tools.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5-alpha.2",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-credentials": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-alpha.5",
    "@deepseek-ai/dsh-launch-environment": "0.2.1-alpha.5",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@node-rs/argon2": "^2.1.0",
    "chokidar": "^5.0.0",
    "valibot": "^1.4.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@mzwing/oxc-config": "0.1.4",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "knip": "6.32.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.2"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
